{
  "name": "solar-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "watch": "ng build --watch --configuration development",
    "clean": "rimraf dist",
    "mkdirp": "mkdirp reports",
    "build": "ng build --configuration production",
    "build-prod-ci-high-memory": "node ./node_modules/@angular/cli/bin/ng build --configuration production --progress=false",
    "stylelint": "stylelint src/**/*.scss --formatter node_modules/stylelint-formatter-html/index.js 2> reports/stylelint-results.html",
    "lint": "npm run stylelint && ng lint --fix"
  },
  "private": true,
  "dependencies": {
    "@abacritt/angularx-social-login": "^2.4.0",
    "@angular/animations": "^22.2.2",
    "@angular/cdk": "^21.0.5",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^21.0.5",
    "@angular/material-moment-adapter": "^21.0.5",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@angular/router": "^22.2.2",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "ng2-charts": "^8.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "~22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript-eslint/utils": "^8.0.0",
    "baseline-browser-mapping": "^2.11.28",
    "eslint": "^10.12.0",
    "mkdirp": "^3.0.1",
    "rimraf": "^6.1.3",
    "stylelint": "^16.26.1",
    "stylelint-config-sass-guidelines": "^12.1.0",
    "stylelint-formatter-html": "^1.0.1",
    "stylelint-no-unsupported-browser-features": "^8.0.5",
    "stylelint-use-nesting": "^6.0.1",
    "typescript": "~6.0.3"
